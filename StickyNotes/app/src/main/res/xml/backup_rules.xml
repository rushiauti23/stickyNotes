<!-- Android 9–11. Same policy: only back up when client-side (end-to-end) encryption is available. -->
<full-backup-content>
    <include domain="database" path="." requireFlags="clientSideEncryption" />
    <include domain="sharedpref" path="." requireFlags="clientSideEncryption" />
</full-backup-content>
